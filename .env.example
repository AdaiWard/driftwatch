# ── Local profile (без docker) ────────────────────────────────────────────
# Postgres-кластер живёт под юзером в .data/pg (см. README), порт 5433
DATABASE_URL=postgres://driftwatch@localhost:5433/driftwatch
REDIS_URL=redis://localhost:6379

STORAGE_DRIVER=fs
# Относительный путь считается от каталога, из которого запущен процесс.
# Для запуска API и worker из разных каталогов укажите общий абсолютный путь.
FS_ROOT=.data/objects

PORT=3000
WORKER_CONCURRENCY=1
LOG_LEVEL=info

# ── Docker profile (docker compose up) ────────────────────────────────────
# раскомментировать и закомментировать блок выше:
# DATABASE_URL=postgres://driftwatch:driftwatch@postgres:5432/driftwatch
# REDIS_URL=redis://redis:6379
# STORAGE_DRIVER=s3
# S3_ENDPOINT=http://minio:9000
# S3_BUCKET=driftwatch
# S3_REGION=us-east-1
# S3_ACCESS_KEY=driftwatch
# S3_SECRET_KEY=driftwatch-secret
